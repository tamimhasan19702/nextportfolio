# Local dev: Docker container (mongo:7) as nextportfolio-mongo:27017
# Production: replace with your Atlas URL (mongodb+srv://...) and
# URL-encode any special characters in your password (e.g. @ -> %40)
MONGODB_URI=mongodb://localhost:27017/nextportfolio

# Payload CMS secret - generate your own with: openssl rand -hex 48
# Example value below - REPLACE with your own strong random string
PAYLOAD_SECRET=

# Supabase Storage (S3-compatible) for Payload media
S3_ENDPOINT=
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto